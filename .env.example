# 复制为 .env 后按需修改；.env 已在 .gitignore 中，禁止入库。
# 本地开发库由 docker-compose.yml 提供（宿主端口 5433）。
DATABASE_URL=postgres://music_drift:music_drift_dev@localhost:5433/music_drift

# apps/api
PORT=8788
HOST=0.0.0.0
LOG_LEVEL=info

# 管理员种子口令（t32 用户裁决·脱敏）：复制本文件为 .env 后在此填真实值。
# 禁止把真口令写进任何入库文件（源码/文档/示例）；缺失时 db:seed 跳过管理员种子。
SEED_ADMIN_PASSWORD=
